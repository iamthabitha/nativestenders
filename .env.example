# Copy this file to .env and fill in your own values. Never commit .env.

# --- Gmail sending account ---
# The Gmail address the alerts will be sent FROM.
GMAIL_ADDRESS=youraddress@gmail.com
# A 16-character Gmail "App Password" (NOT your normal password).
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Where alerts get sent ---
# Comma-separated list of one or more recipient addresses.
ALERT_RECIPIENTS=youraddress@gmail.com

# --- Keyword filter ---
# Comma-separated. Case-insensitive. Matched against tender title + description.
KEYWORDS=newspaper,advertising,media buying,radio,billboard

# --- Lookback window ---
# How many days back to re-check on every run. Wide enough to catch
# amendments/errata on tenders published earlier, narrow enough to stay fast.
LOOKBACK_DAYS=30

# --- OCDS API base URL (rarely needs changing) ---
OCDS_API_BASE=https://ocds-api.etenders.gov.za/api/OCDSReleases
